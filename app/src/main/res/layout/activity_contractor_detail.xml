<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center">

                <ImageView
                    android:id="@+id/img_contractor_logo"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@android:drawable/ic_menu_my_calendar"
                    android:scaleType="centerCrop"
                    android:background="#EEEEEE"
                    android:padding="1dp"/>

                <TextView
                    android:id="@+id/tv_detail_contractor_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contractor Name"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:layout_marginTop="12dp"
                    android:gravity="center"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Contact Information"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tv_detail_contractor_contact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Person: -"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tv_detail_contractor_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email: -"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Address"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tv_detail_contractor_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="-"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Expertise &amp; Specialization"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tv_detail_contractor_expertise"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="-"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Active Projects"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerContractorProjects"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:background="#FFFFFF"/>

        <TextView
            android:id="@+id/tvNoProjects"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No active projects found."
            android:gravity="center"
            android:padding="24dp"
            android:textColor="#999999"
            android:visibility="gone"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>