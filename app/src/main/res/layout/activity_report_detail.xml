<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_detail_report_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PENDING"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="#FF9800"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="12sp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tv_detail_report_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Report Title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tv_detail_report_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Category: Infrastructure"
            android:textSize="14sp"
            android:textColor="#757575"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Description"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tv_detail_report_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Full description goes here..."
            android:textSize="16sp"
            android:lineSpacingMultiplier="1.2"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Location"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tv_detail_report_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="123 Street Name"
            android:layout_marginBottom="32dp"/>

        <LinearLayout
            android:id="@+id/layout_linked_project"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#E0F2F1"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Related Project"
                android:textColor="#00695C"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_detail_project_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Road Widening Project"
                android:textSize="16sp"
                android:layout_marginTop="4dp"/>

            <Button
                android:id="@+id/btn_detail_report_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View Project Details"
                android:layout_marginTop="8dp"
                android:backgroundTint="#009688"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>